# Google Analytics 4 (GA4) Configuration
# Obtain your Measurement ID from: Google Analytics > Admin > Data Streams > Web > Measurement ID
# Format: G-XXXXXXXXXX
GA_ID=G-XXXXXXXXXX

# Optional alias (supported as fallback if you previously configured NEXT_PUBLIC_GOOGLE_ANALYTICS)
# NEXT_PUBLIC_GOOGLE_ANALYTICS=G-XXXXXXXXXX
